# ─── Naver Commerce API (https://apicenter.commerce.naver.com) ─────────
# OAuth 2.0 + bcrypt 서명용
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ─── Coupang Wing API (https://wing.coupang.com) ──────────────────────
# HMAC-SHA256 서명용
COUPANG_VENDOR_ID=
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# ─── Groq API ─────────────────────────────────────────────────────────
GROQ_API_KEY=your_api_key_here

# ─── 이익 계산 비율 (외부 유출 방지) ────────────────────────────────
ONLINE_MATERIAL_RATE=
OFFLINE_MATERIAL_RATE=

# ─── 배송비 / 마크업 설정 ──────────────────────────────────────────
NAVER_SHIPPING_FEE=3000       # 고객 배송비
NAVER_SHIPPING_COST=3300      # 실제 배송 비용
COUPANG_SHIPPING_MARKUP=2000  # 쿠팡 상품 가격 마크업 (배송비 보전)

# ─── 브라우저 세션 유효기간 (쿠팡 정산 스크래핑용, 일 단위, 기본값: 30) ─
SESSION_TTL_DAYS=30
